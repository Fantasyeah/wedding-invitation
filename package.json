{
  "name": "wedding-invitation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "婚礼邀请函 · Cloudflare Pages + Functions + D1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "dev": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply wedding-invitation-rsvp --local",
    "db:migrate:remote": "wrangler d1 migrations apply wedding-invitation-rsvp --remote"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
